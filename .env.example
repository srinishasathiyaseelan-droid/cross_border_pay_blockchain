# CrossPay configuration. Copy to .env and fill in. Never commit .env.

# --- Core ---------------------------------------------------------------
CROSSPAY_ENV=dev                 # dev | demo | prod  (test is used by pytest)
SECRET_KEY=                      # required when CROSSPAY_ENV=prod: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_DEBUG=0                    # 1 enables the Werkzeug debugger; never on a reachable port
DEMO_MODE=1                      # 1 = quick logins, KYC simulation and fixed demo scenarios for the viva
DEMO_SME_PASSWORD=               # seed password for demo@globallogistics.com (random if empty)
DEMO_ADMIN_PASSWORD=             # seed password for admin@crosspay.org (random if empty)

# --- Storage ------------------------------------------------------------
DB_PATH=instance/crosspay.db
LEDGER_PATH=instance/blockchain_ledger.json   # derived explorer view, rebuilt from the audit chain
UPLOAD_DIR=instance/uploads
LEDGER_SIGNING_KEY=              # HMAC key for the audit chain; required when CROSSPAY_ENV=prod
POW_DIFFICULTY=3

# --- Model and policy ---------------------------------------------------
MODEL_PATH=model/random_forest_model.pkl
REVIEW_AT=40                     # risk score at or above this -> HOLD
BLOCK_AT=80                      # risk score at or above this -> BLOCK
INVOICE_REQUIRED_ABOVE_USD=50000

# --- Exchange rates -----------------------------------------------------
EXCHANGE_RATE_API_KEY=           # optional; open.er-api.com is used without a key
EXCHANGE_RATE_CACHE_TTL=3600
EXCHANGE_RATE_TIMEOUT=8
EXCHANGE_RATE_MAX_STALE_HOURS=24

# --- Advisory LLM layer (never decides APPROVE/HOLD/BLOCK) ----------------
LLM_ENABLED=0                    # kill switch; the app is fully usable with 0
LLM_PROVIDERS=groq,nvidia,cloudflare   # fallback order; providers without keys are skipped
LLM_TIMEOUT=15
LLM_DAILY_BUDGET_USD=1.00
LLM_LOG_RETENTION_DAYS=30
AI_RATE_LIMIT=30 per hour
AI_EXPLAIN=1
AI_PURPOSE=1
AI_COPILOT=1
AI_INVOICE=1
AI_NLQ=1
AI_ASSIST=1
AI_REPORTS=1

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
NVIDIA_API_KEY=
NVIDIA_MODEL=openai/gpt-oss-20b

# --- Rate limiting --------------------------------------------------------
RATELIMIT_STORAGE_URI=memory://
TRUSTED_PROXIES=                 # comma-separated IPs/CIDRs whose X-Forwarded-For is honoured
